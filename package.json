{
  "name": "tfs-frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:customer": "turbo run dev --filter=@tfs/customer",
    "dev:professional": "turbo run dev --filter=@tfs/professional",
    "dev:team": "turbo run dev --filter=@tfs/team",
    "dev:landing": "turbo run dev --filter=@tfs/landing",
    "prepare": "husky",
    "docker:build:customer": "docker build --build-context lockfile=. -t tfs-customer apps/customer",
    "docker:build:professional": "docker build --build-context lockfile=. -t tfs-professional apps/professional",
    "docker:build:team": "docker build --build-context lockfile=. -t tfs-team apps/team",
    "docker:build:landing": "docker build --build-context lockfile=. -t tfs-landing apps/landing"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "turbo": "^2.3.3"
  }
}
