pipeline {
  agent any
  stages {
    stage('Deploy Application on Labe1 server'){
            steps {
                echo 'Deployment'
                sshagent(credentials: ['jenkins-ssh-proxy']) {
                  sh '''
                    mkdir -p ~/.ssh && chmod 700 ~/.ssh
                    ssh-keyscan -H ${DEPLOY_HOST} >> ~/.ssh/known_hosts
                    ssh ${DEPLOY_USER}@${DEPLOY_HOST} sh ${DEPLOY_SCRIPT_PATH}
                  '''
                }
            }
    }
  }
  post {
        always {
            cleanWs()
        }
    }
}